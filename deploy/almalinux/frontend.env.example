# Copy this file to /opt/wavelab/app/frontend/.env.production before building.
# Only put browser-safe public values here. Do not put JWT secrets here.
# Use http://SERVER_IP while there is no domain. Switch to https://DOMAIN after TLS is enabled.

VITE_API_URL=__PUBLIC_ORIGIN__
VITE_MAPBOX_ACCESS_TOKEN=replace-with-public-mapbox-token
