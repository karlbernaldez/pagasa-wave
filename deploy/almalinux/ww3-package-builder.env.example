# Copy to /etc/wavelab/ww3-package-builder.env and keep root-owned mode 0600.
APP_ROOT=/home/wavelab/app
WAVETILES_ROOT=/home/wavelab/app/wavetiles
SOURCE_ARCHIVE_DIR=/home/darwin/ww3_nc

# The modeling-team archive must stop changing for this many minutes before import.
ARCHIVE_STABILITY_MINUTES=10

# Retention policy.
SOURCE_ARCHIVE_RETENTION_DAYS=10
INPUT_CYCLE_RETENTION_DAYS=10
TILE_PACKAGE_RETENTION_DAYS=10
MIN_TILE_PACKAGES_TO_KEEP=3
FAILED_BUILD_RETENTION_DAYS=2

# Avoid building stale historical packages when automation is first enabled.
MAX_PACKAGE_AGE_DAYS=3

# Start with 1. Review journald deletion candidates, then change to 0.
CLEANUP_DRY_RUN=1

WW3_VAR=hs
WW3_SIGMA=1.5
WW3_BUILD_TIMEOUT=4h
WW3_BUILD_WORKERS=4
WW3_BUILD_EXTRA_ARGS=--skip-existing

# Product input mode. Keep raw during rollout; switch to normalized only for a supervised run.
WW3_PRODUCT_INPUT=raw

# Optional shared normalized dataset root.
# WAVE_NORMALIZED_ROOT=/home/wavelab/app/wavetiles/normalized

# Optional. Use a dedicated Discord webhook or the existing operations webhook.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
