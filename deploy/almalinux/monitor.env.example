# WaveLab production health monitor
#
# Copy this file to /etc/wavelab/monitor.env and restrict it:
#   sudo chown root:root /etc/wavelab/monitor.env
#   sudo chmod 600 /etc/wavelab/monitor.env

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-real-webhook
FAILURE_THRESHOLD=2
DISK_THRESHOLD=80
STATUS_URL=http://127.0.0.1:5000/status
HOST_LABEL=vote3

# Pipeline degradation alerts.
# The health monitor itself still debounces these conditions with FAILURE_THRESHOLD.
PIPELINE_ALERTS_ENABLED=1
PIPELINE_CONSECUTIVE_FAILURE_THRESHOLD=2
PIPELINE_MAX_RUN_AGE_HOURS=36
PIPELINE_MAX_RUN_DURATION_SECONDS=7200
PIPELINE_MALFORMED_RECORD_THRESHOLD=1
