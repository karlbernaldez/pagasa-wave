[Unit]
Description=WaveLab wave source readiness checker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wavelab
Group=wavelab
EnvironmentFile=-/etc/wavelab/ww3-package-builder.env
EnvironmentFile=-/etc/wavelab/ecwam-package-builder.env
ExecStart=/home/wavelab/app/wavetiles/.venv/bin/python /home/wavelab/app/wavetiles/scripts/check_wave_source_readiness.py
UMask=0022
TimeoutStartSec=5min
Nice=10
CPUWeight=20
IOWeight=20
StateDirectory=wavelab-wave-source-readiness
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/home/wavelab/app/wavetiles/.normalized-product-stage
ReadWritePaths=/var/lib/wavelab-wave-source-readiness
