[Unit]
Description=WaveLab ECWAM package retry builder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wavelab
Group=wavelab
EnvironmentFile=/etc/wavelab/ecwam-package-builder.env
Environment=LOCK_FILE=/run/wavelab-ecwam/package-builder.lock
ExecStart=/usr/local/sbin/wavelab-ecwam-package-builder
UMask=0022
TimeoutStartSec=5h
Nice=5
CPUWeight=50
IOWeight=50
StateDirectory=wavelab-ecwam
StateDirectoryMode=0700
RuntimeDirectory=wavelab-ecwam
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/home/wavelab/app/wavetiles/tiles/ECWAM
ReadWritePaths=/run/wavelab-ecwam

[Install]
WantedBy=multi-user.target
