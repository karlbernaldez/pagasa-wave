# Copy this file to /etc/wavelab/backend.env and set real values.
# Never commit the real backend.env file.

NODE_ENV=production
PORT=5000

# Data stores
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379

# Authentication secrets. Use long random values and keep them server-side only.
JWT_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ADMIN_KEY=replace-with-long-random-admin-key

# Browser origins allowed to send credentials to the API.
# Use HTTPS after TLS is enabled.
CORS_ALLOWED_ORIGINS=https://__DOMAIN__

# Runtime directories are relative to /opt/wavelab/app/backend.
FRAME_COUNT=24
CRON=*/30 * * * *
GIF_DELAY=8
SAVE_DIR=./frames
PUBLIC_DIR=./public
TMP_DIR=./tmp

# Optional external/source tokens. Leave blank unless the feature needs them.
TOKEN=
XSRF_TOKEN=
PANAHON_SESSION=

# Optional public chart raster/tile configuration.
# Fill these when published WW3 or COG tile rendering depends on external tile services.
PUBLIC_WAVE_MODEL_RUN_HOUR=18
PUBLIC_WAVE_MODEL_RUN_DAY_OFFSET=-1
PUBLIC_WAVE_COG_URL_TEMPLATE=
PUBLIC_WAVE_COG_TILE_TEMPLATE=
PUBLIC_COG_TILE_TEMPLATE=
TITILER_COG_TILE_TEMPLATE=
