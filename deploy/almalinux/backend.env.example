NODE_ENV=production
PORT=5000
BIND_HOST=127.0.0.1

MONGO_URI=replace-with-mongodb-connection-string
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-secret
CSRF_SECRET=replace-with-a-third-independent-at-least-32-random-secret

COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
CORS_ALLOWED_ORIGINS=__PUBLIC_ORIGIN__
PUBLIC_ORIGIN=__PUBLIC_ORIGIN__
PUBLISHED_ARTIFACT_DIR=/var/lib/wavelab/published-artifacts
# Optional local-development fallback to authoritative server WaveTiles, e.g. https://your-domain.com/wavetiles
WAVELAB_WAVE_TILES_REMOTE_BASE_URL=

OTP_REQUIRED=true
LOG_OTP_FOR_TESTING=false

ADMIN_KEY=replace-with-admin-key
WAVELAB_CHAT_ENABLED=false
