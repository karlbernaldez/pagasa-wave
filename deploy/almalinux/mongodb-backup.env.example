# Root-readable production configuration for wavelab-mongodb-backup.
# Install as /etc/wavelab/mongodb-backup.env with mode 0600.

# Public recipient only. Never place the age private identity on production.
AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT

# Existing private Discord webhook used for encrypted backup delivery and alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Keep the newest 14 backup sets whose Discord upload was confirmed.
RETENTION_COUNT=14

# Require at least 1 GiB free before starting a new dump.
MIN_FREE_KIB=1048576
