#!/usr/bin/env bash
set -Eeuo pipefail

BACKUP_ROOT="${BACKUP_ROOT:-/var/backups/wavelab/mongodb}"
BACKEND_ENV="${BACKEND_ENV:-/etc/wavelab/backend.env}"
BACKUP_ENV="${BACKUP_ENV:-/etc/wavelab/mongodb-backup.env}"
LOCK_FILE="${LOCK_FILE:-/run/lock/wavelab-mongodb-backup.lock}"
RETENTION_COUNT="${RETENTION_COUNT:-14}"
MIN_FREE_KIB="${MIN_FREE_KIB:-1048576}"

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
fail() { log "ERROR: $*" >&2; exit 1; }

send_alert() {
  local status="$1" message="$2" payload
  [[ -n "${DISCORD_WEBHOOK_URL:-}" ]] || return 0
  payload="$(python3 - "$status" "$message" <<'PY'
import json, sys
status, message = sys.argv[1:]
icon = "✅" if status == "SUCCESS" else "🚨"
print(json.dumps({"content": f"{icon} WaveLab MongoDB backup {status}\n{message}"}))
PY
)"
  curl -fsS --max-time 30 -H 'Content-Type: application/json' -d "$payload" "$DISCORD_WEBHOOK_URL" >/dev/null || true
}

on_error() {
  local rc=$? line=${BASH_LINENO[0]:-unknown} message
  printf -v message \
    'Host: %s\nExit: %s\nLine: %s\nLocal backup artifacts were not deleted.' \
    "$(hostname -f 2>/dev/null || hostname)" \
    "$rc" \
    "$line"
  send_alert FAILURE "$message"
  exit "$rc"
}
trap on_error ERR

[[ $EUID -eq 0 ]] || fail "run as root"
[[ -r "$BACKEND_ENV" ]] || fail "cannot read $BACKEND_ENV"
[[ -r "$BACKUP_ENV" ]] || fail "cannot read $BACKUP_ENV"
# shellcheck disable=SC1090
source "$BACKUP_ENV"
[[ "${AGE_RECIPIENT:-}" =~ ^age1[0-9a-z]+$ ]] || fail "AGE_RECIPIENT must contain only the public age recipient"
[[ -n "${DISCORD_WEBHOOK_URL:-}" ]] || fail "DISCORD_WEBHOOK_URL is required"
[[ "$RETENTION_COUNT" =~ ^[1-9][0-9]*$ ]] || fail "RETENTION_COUNT must be a positive integer"
for cmd in age curl flock mongodump mongosh python3 sha256sum tar timeout; do command -v "$cmd" >/dev/null || fail "$cmd is not installed"; done

umask 077
install -d -m 0700 -o root -g root "$BACKUP_ROOT"
exec 9>"$LOCK_FILE"
flock -n 9 || fail "another MongoDB backup run is active"

MONGO_URI="$(sed -n 's/^MONGO_URI=//p' "$BACKEND_ENV" | tail -n 1)"
[[ -n "$MONGO_URI" ]] || fail "MONGO_URI is missing"
available_kib="$(df -Pk "$BACKUP_ROOT" | awk 'NR==2 {print $4}')"
[[ "$available_kib" =~ ^[0-9]+$ ]] || fail "cannot determine free disk space"
(( available_kib >= MIN_FREE_KIB )) || fail "less than ${MIN_FREE_KIB} KiB free"

probe='const h=db.hello(); print(JSON.stringify({database:db.getName(),topology:h.setName?"replicaSet":(h.msg==="isdbgrid"?"sharded":"standalone"),setName:h.setName||null,isWritablePrimary:h.isWritablePrimary===true}));'
probe_json="$(timeout 30 mongosh "$MONGO_URI" --quiet --norc --eval "$probe" 2>/dev/null)"
grep -Eq '"topology":"(standalone|replicaSet)"' <<<"$probe_json" || fail "automation supports only standalone or replica-set topology"
grep -q '"isWritablePrimary":true' <<<"$probe_json" || fail "MongoDB is not writable primary"
database="$(sed -n 's/.*"database":"\([^"]*\)".*/\1/p' <<<"$probe_json")"
topology="$(sed -n 's/.*"topology":"\([^"]*\)".*/\1/p' <<<"$probe_json")"
set_name="$(sed -n 's/.*"setName":"\([^"]*\)".*/\1/p' <<<"$probe_json")"
[[ "$database" =~ ^[A-Za-z0-9_-]+$ ]] || fail "unsupported database name"
[[ "$topology" == standalone || "$topology" == replicaSet ]] || fail "unsupported MongoDB topology"
if [[ "$topology" == replicaSet ]]; then
  [[ "$set_name" =~ ^[A-Za-z0-9._-]+$ ]] || fail "invalid replica-set name"
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
stem="wavelab-${database}-${timestamp}"
archive="$BACKUP_ROOT/$stem.archive.gz"
partial="$archive.partial"
checksum="$archive.sha256"
manifest="$archive.manifest"
bundle="$BACKUP_ROOT/$stem.backup.tar"
encrypted="$bundle.age"
encrypted_partial="$encrypted.partial"
encrypted_checksum="$encrypted.sha256"
upload_marker="$BACKUP_ROOT/$stem.discord-uploaded"
cleanup() { rm -f -- "$partial" "$bundle" "$encrypted_partial"; }
trap cleanup EXIT

started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
log "creating logical dump for $database from $topology${set_name:+/$set_name}"
timeout 30m mongodump --uri="$MONGO_URI" --db="$database" --archive="$partial" --gzip
[[ -s "$partial" ]] || fail "mongodump produced an empty archive"
mv -- "$partial" "$archive"
sha256sum "$archive" > "$checksum"
sha256sum --check "$checksum" >/dev/null

cat > "$manifest" <<EOF
backup_status=UNVERIFIED_PENDING_RESTORE_TEST
source_host=$(hostname -f 2>/dev/null || hostname)
source_database=$database
source_topology=$topology
source_replica_set=${set_name:-none}
consistency=logical_dump_not_point_in_time_consistent
archive_file=$(basename "$archive")
archive_size_bytes=$(stat -c '%s' "$archive")
sha256=$(awk '{print $1}' "$checksum")
started_utc=$started
completed_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
retention_count=$RETENTION_COUNT
off_host_copy_verified=false
restore_test_verified=false
EOF
chmod 0600 "$archive" "$checksum" "$manifest"

tar -C "$BACKUP_ROOT" -cf "$bundle" "$(basename "$archive")" "$(basename "$checksum")" "$(basename "$manifest")"
age -r "$AGE_RECIPIENT" -o "$encrypted_partial" "$bundle"
mv -- "$encrypted_partial" "$encrypted"
sha256sum "$encrypted" > "$encrypted_checksum"
chmod 0600 "$encrypted" "$encrypted_checksum"

payload="$(python3 - "$stem" "$encrypted" "$encrypted_checksum" <<'PY'
import json, os, sys
stem, encrypted, checksum = sys.argv[1:]
sha = open(checksum, encoding='utf-8').read().split()[0]
print(json.dumps({"content": f"🔐 WaveLab MongoDB daily backup\nBackup: {stem}\nEncrypted size: {os.path.getsize(encrypted)} bytes\nSHA-256: {sha}\nConsistency: logical dump, not point-in-time consistent"}))
PY
)"
curl -fsS --max-time 180 -F "payload_json=$payload" -F "files[0]=@$encrypted;type=application/octet-stream" -F "files[1]=@$encrypted_checksum;type=text/plain" "$DISCORD_WEBHOOK_URL" >/dev/null
printf 'uploaded_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$upload_marker"
chmod 0600 "$upload_marker"

mapfile -t uploaded < <(find "$BACKUP_ROOT" -maxdepth 1 -type f -name 'wavelab-*.discord-uploaded' -printf '%f\n' | sort -r)
if ((${#uploaded[@]} > RETENTION_COUNT)); then
  for marker_name in "${uploaded[@]:RETENTION_COUNT}"; do
    old_stem="${marker_name%.discord-uploaded}"
    rm -f -- "$BACKUP_ROOT/$old_stem.archive.gz" "$BACKUP_ROOT/$old_stem.archive.gz.sha256" "$BACKUP_ROOT/$old_stem.archive.gz.manifest" "$BACKUP_ROOT/$old_stem.backup.tar.age" "$BACKUP_ROOT/$old_stem.backup.tar.age.sha256" "$BACKUP_ROOT/$old_stem.discord-uploaded"
    log "retained newest $RETENTION_COUNT uploaded backups; removed $old_stem"
  done
fi

trap - ERR
cleanup
trap - EXIT
printf -v success_message \
  'Host: %s\nBackup: %s\nDiscord upload confirmed.\nRetention: newest %s successfully uploaded daily backups.' \
  "$(hostname -f 2>/dev/null || hostname)" \
  "$stem" \
  "$RETENTION_COUNT"
send_alert SUCCESS "$success_message"
log "backup, encryption, upload, and retention completed: $stem"
