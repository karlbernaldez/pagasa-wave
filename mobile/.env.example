# Base URL of the existing WaveLab backend, without a trailing slash.
# For an Android emulator, localhost on your PC is reached through 10.0.2.2.
# Example local backend:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# For a physical phone, use your computer's LAN IP instead, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:5000
